  story_id uuid [not null]
  genre_id uuid [not null]

  indexes {
    (story_id, genre_id) [pk]
  }
}

Table chapters {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  story_id uuid [not null]
  title varchar(300) [not null]
