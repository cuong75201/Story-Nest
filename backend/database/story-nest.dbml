Enum user_role {
  USER
  ADMIN
}

Enum account_status {
  ACTIVE
  SUSPENDED
  DELETED
}

Enum visibility {
  PUBLIC
  PRIVATE
}

Enum story_state {
  DRAFT
  ONGOING
  COMPLETED
  HIATUS
}

Enum publication_status {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

Enum comment_status {
  ACTIVE
  HIDDEN
  REMOVED
}

Enum report_status {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

Enum notification_type {
  NEW_CHAPTER
  STORY_UPDATED
  NEW_FOLLOWER
  COMMENT
  REPORT_RESOLVED
  SYSTEM
}

Table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email varchar(320) [not null, unique]
  username varchar(50) [not null, unique]
