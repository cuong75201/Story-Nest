}

Table comments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  author_id uuid [not null]
  story_id uuid [note: 'Exactly one of story_id or chapter_id is required']
  chapter_id uuid [note: 'Exactly one of story_id or chapter_id is required']
