  indexes {
    (user_id, story_id) [pk]
  }
}

Table story_favorites {
  user_id uuid [not null]
  story_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, story_id) [pk]
  }
}

